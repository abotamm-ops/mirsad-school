function commercialMultiError_(message,code){var e=new Error(message);e.code=code;throw e}
function commercialCampusPublic_(site){return {id:site.id,localId:site.localId,profile:site.profile,legacy:!!site.legacy}}
function commercialDiscoverCampus_(school){var base=commercialStorageFor_(school,monitorToday_()),previous=COMMERCIAL_CONTEXT_;try{COMMERCIAL_CONTEXT_={school:school,storage:base};var root=commercialSchoolDrive_().getFolderById(base.rootId),source=monitorRead_(monitorFile_(root,'mirsad-timetable-source.json'),{});return {id:String(source.schoolId||source.payload?.schoolId||'').toLowerCase(),hasData:root.getFolders().hasNext()}}finally{COMMERCIAL_CONTEXT_=previous}}
function commercialEnsureCampus_(school,site){var base=DriveApp.getFolderById(school.rootId);if(!site.localRootId){var name='مدرسة-'+site.id,it=base.getFoldersByName(name);site.localRootId=commercialPrivate_(it.hasNext()?it.next():base.createFolder(name)).getId()}if(!site.legacy){var local=DriveApp.getFolderById(site.localRootId);if(!monitorFile_(local,'service-properties.json'))commercialWriteFile_(local,'service-properties.json',{MONITOR_EVIDENCE_PRIVATE:'true',MONITOR_ARCHIVE_PRIVATE:'true'})}var link=schoolDriveLink_(school.id);if(link&&!link.revoked&&!site.remoteRootId){if(site.legacy)site.remoteRootId=link.rootId;else{var drive=schoolDriveAdapter_(school),root=drive.getFolderById(link.rootId),name='مدرسة-'+site.id,it=root.getFoldersByName(name);site.remoteRootId=(it.hasNext()?it.next():root.createFolder(name)).getId()}}}
function commercialMultiSchool_(school,id){if(school._site)return school;var site=school.campuses?.find(x=>x.id===(id||school.activeSiteId));if(!site){if(id)commercialMultiError_('المدرسة غير موجودة في هذا الحساب','site-scope');if(!school.campuses?.length)return school;commercialMultiError_('حمّل جدول المدرسة أولًا من الإضافة','site-required')}return {...school,rootId:site.localRootId,_accountRootId:school.rootId,_site:site,profile:site.profile,viewerToken:site.viewerToken}}
function commercialCampusActor_(actor,p){var requested=actor.siteId||p.siteId;if(actor.school.campuses?.length>1&&!requested&&p.action!=='adminLogin')commercialMultiError_('اختر المدرسة من القائمة أو حدّث الصفحة','site-required');if(actor.role==='viewer'&&p.siteId&&actor.siteId!==p.siteId)commercialMultiError_('رابط المشاهدة خاص بمدرسة أخرى','site-scope');return {...actor,school:commercialMultiSchool_(actor.school,requested)}}
function commercialCampusReady_(school,site){var scoped=commercialMultiSchool_(school,site.id),previous=COMMERCIAL_CONTEXT_;try{var storage=commercialStorageFor_(scoped,monitorToday_());COMMERCIAL_CONTEXT_={school:scoped,storage:storage};var root=commercialSchoolDrive_().getFolderById(storage.rootId),day=monitorScheduleFolder_(root,monitorToday_(),false),data=day&&monitorRead_(monitorFile_(day,'attendance.json'),null);if(!data?.snapshot?.scheduleRevision)commercialMultiError_('حمّل جدول المدرسة لليوم قبل بدء الرصد','site-not-ready')}finally{COMMERCIAL_CONTEXT_=previous}}
function commercialMultiBefore_(p,actor){var s=actor.school,site=s._site,write=['heartbeat','setMonitoringTiming','publishMonitoringTimetable','classicStartDay','prepareCurrentTimetable','record','image','setTimetableSource','publishMadrasatiTimetable','startDay','adoptTimetable','fillMissingLinks','addCalendarLinks','videoPoll','videoUpdate','videoUploadBegin','videoUploadFinish','restoreArchivedSchedule'];if(actor.role==='recorder'&&write.includes(p.action)&&(!site||p.siteId!==site.id||p.multiProtocol!=='multi-v1'))commercialMultiError_('حدّث إضافة المدارس لتحميل المدرسة المطلوبة بأمان','extension-update-required');if(site&&p.payload?.source==='madrasati'&&String(p.payload.schoolId||'').toLowerCase()!==site.id)commercialMultiError_('الجدول يخص مدرسة أخرى؛ أعد تحميل صفحة المدرسة الحالية','site-scope');if(site&&p.record&&(p.record.siteId&&p.record.siteId!==site.id||p.record.accountId&&p.record.accountId!==s.id||p.record.localSchoolId&&p.record.localSchoolId!==site.localId))commercialMultiError_('النتيجة تخص مدرسة أخرى؛ لم تُخلط الأرشيفات','site-scope');var needsLease=['classicStartDay','prepareCurrentTimetable','record','image','startDay'];if(actor.role==='recorder'&&(needsLease.includes(p.action)||p.action==='heartbeat'&&p.running===true||p.action==='videoPoll'&&p.ready===true&&p.gap)){var lease=s.monitorLease;if(!lease||lease.until<=Date.now()||lease.runToken!==p.runToken||lease.siteId!==site.id||lease.deviceId!==s.device.id)commercialMultiError_('لا توجد جلسة رصد صالحة لهذه المدرسة؛ أعد بدء الرصد','monitor-session-expired')}}
function commercialMultiAfter_(p,result,actor){var site=actor.school._site;if(site){result.accountId=actor.school.id;result.schoolId=site.localId;result.siteId=site.id;result.site=commercialCampusPublic_(site);if(result.job){result.job.siteId=site.id;result.job.localSchoolId=site.localId;result.job.accountId=actor.school.id;}if(result.snapshot)result.snapshot.siteId=site.id;if(p.action==='getTimetableSource')result.boundSchoolId=site.id;if(result.school){result.school.profile=site.profile;result.school.siteId=site.id}if(p.action==='teacherLink'&&result.url)result.url+='&siteId='+encodeURIComponent(site.id)}return result}
function commercialMultiRequest_(registry,p){if(p.action==='commercialSchoolSpaces')return registry.spaces(p);if(p.action==='commercialSelectSchool')return registry.selectSpace(p);if(p.action==='commercialMonitorSession')return registry.monitorSession(p);if(p.action==='commercialResetUsername')return registry.resetUsername(p.key,p);throw new Error('طلب غير مدعوم')}
