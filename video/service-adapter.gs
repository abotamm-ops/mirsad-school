function monitorVideoPending_(props,date,value,kind){var key='MONITOR_VIDEO_DELETE_PENDING_'+kind,map;try{map=JSON.parse(props.getProperty(key)||'{}')}catch(e){map={}}if(value===undefined)return map[date]===true;if(value)map[date]=true;else delete map[date];props.setProperty(key,JSON.stringify(map));return value===true}
