function commercialBillingPublic_(r){var c=r.billingSettings||{},live=c.enabled===true&&c.offerEnabled===true&&Number(c.offerEndsAt)>Date.now();return {providerName:c.providerName||'',supportEmail:c.supportEmail||'',termsApproved:c.termsApproved===true,enabled:c.enabled===true,termsVersion:COMMERCIAL_BILLING_TERMS_VERSION,serverTime:Date.now(),offerActive:live,offerEndsAt:live?c.offerEndsAt:0,offerConfigured:c.offerEnabled===true,configuredOfferEndsAt:c.offerEndsAt||0,accounts:commercialOwnerSettingsPublic_(r).accounts||[],plans:[{id:'week',label:'أسبوع',amount:50},{id:'month',label:'شهر',amount:100},{id:'twoMonths',label:'شهران',amount:live?150:200}],currency:'SAR'}}
function commercialValidateInvoice_(file){file=file||{};var name=String(file.name||'').replace(/[\\/\x00-\x1f]/g,'_').slice(0,140),ext=(name.match(/\.([a-z0-9]+)$/i)||[])[1]?.toLowerCase(),text=String(file.base64||'');if(!text||text.length>5592408||!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(text))throw new Error('الملف فارغ أو أكبر من 4 ميغابايت');var bytes=Utilities.base64Decode(text);if(!bytes.length||bytes.length>4194304)throw new Error('حجم الفاتورة يتجاوز 4 ميغابايت');var hex=bytes.slice(0,12).map(function(x){return ((x+256)%256).toString(16).padStart(2,'0')}).join(''),mime='';if(ext==='pdf'&&hex.startsWith('255044462d'))mime='application/pdf';else if(ext==='docx'&&hex.startsWith('504b0304'))mime='application/vnd.openxmlformats-officedocument.wordprocessingml.document';else if(ext==='doc'&&hex.startsWith('d0cf11e0a1b11ae1'))mime='application/msword';else if(ext==='png'&&hex.startsWith('89504e470d0a1a0a'))mime='image/png';else if(['jpg','jpeg'].includes(ext)&&hex.startsWith('ffd8ff'))mime='image/jpeg';else if(ext==='webp'&&hex.startsWith('52494646')&&hex.slice(16,24)==='57454250')mime='image/webp';if(!mime)throw new Error('ارفع PDF أو Word أو صورة PNG أو JPG أو WebP صحيحة');var canonical=Utilities.base64Encode(bytes);return {name,ext,mime,bytes,base64:canonical,hash:commercialHash_(canonical)}}
