  ownerAccessControl(key,input){const r=load();owner(r,key);if(input){if(input.operation==='blockAll'){const message=String(input.message||'الاشتراك موقوف؛ يرجى تسديد الاشتراك الشهري لتفعيل الحساب.').trim();if(message.length>1000)fail('اختصر الرسالة إلى ألف حرف','validation');let count=0;for(const s of r.schools){if(s.deletedAt)continue;if(s.enabled)count++;s.enabled=false;s.subscriptionMessage=message;s.messageAt=now()}r.accessControl={...(r.accessControl||{}),registrationOpen:false,updatedAt:now(),blockedAt:now(),blockedCount:count};save(r)}else if(input.operation==='registration'){if(typeof input.open!=='boolean')fail('حدد حالة التسجيل','validation');r.accessControl={...(r.accessControl||{}),registrationOpen:input.open,updatedAt:now()};save(r)}else fail('عملية غير معروفة','validation')}return {control:{registrationOpen:r.accessControl?.registrationOpen!==false,updatedAt:r.accessControl?.updatedAt||null,blockedAt:r.accessControl?.blockedAt||null,blockedCount:r.accessControl?.blockedCount||0}}},
