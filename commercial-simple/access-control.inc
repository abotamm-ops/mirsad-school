  ownerAccessControl(key,input){const r=load();owner(r,key);if(input){if(input.operation==='blockAll'){const message=String(input.message||r.accessControl?.message||'يرجى سداد قيمة الاشتراك: 100 ريال شهريًا لتفعيل الحساب.').trim();if(message.length>1000)fail('اختصر الرسالة إلى ألف حرف','validation');let count=0;for(const s of r.schools){if(s.deletedAt)continue;if(s.enabled){count++;if(!s.bulkAccessBlock)s.bulkAccessBlock={message:s.subscriptionMessage||'',messageAt:s.messageAt||null}}s.enabled=false;s.subscriptionMessage=message;s.messageAt=now()}r.accessControl={...(r.accessControl||{}),registrationOpen:false,message,updatedAt:now(),blockedAt:now(),blockedCount:count};save(r)}else if(input.operation==='restoreAll'){let count=0;for(const s of r.schools){if(s.deletedAt||!s.bulkAccessBlock)continue;s.enabled=true;s.subscriptionMessage=s.bulkAccessBlock.message;s.messageAt=s.bulkAccessBlock.messageAt;delete s.bulkAccessBlock;count++}r.accessControl={...(r.accessControl||{}),updatedAt:now(),restoredAt:now(),restoredCount:count};save(r)}else if(input.operation==='notice'){const message=String(input.message||'').trim();if(!message||message.length>1000)fail('أدخل ملاحظة الاشتراك بما لا يتجاوز ألف حرف','validation');r.accessControl={...(r.accessControl||{}),message,updatedAt:now()};for(const s of r.schools){if(!s.deletedAt&&!s.enabled){s.subscriptionMessage=message;s.messageAt=now()}}save(r)}else if(input.operation==='registration'){if(typeof input.open!=='boolean')fail('حدد حالة التسجيل','validation');r.accessControl={...(r.accessControl||{}),registrationOpen:input.open,updatedAt:now()};save(r)}else fail('عملية غير معروفة','validation')}return {control:{message:r.accessControl?.message||'يرجى سداد قيمة الاشتراك: 100 ريال شهريًا لتفعيل الحساب.',registrationOpen:r.accessControl?.registrationOpen!==false,updatedAt:r.accessControl?.updatedAt||null,blockedAt:r.accessControl?.blockedAt||null,blockedCount:r.accessControl?.blockedCount||0,canRestore:r.schools.some(s=>!s.deletedAt&&s.bulkAccessBlock),restoredCount:r.accessControl?.restoredCount||0}}},
