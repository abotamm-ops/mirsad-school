{
  "manifest_version": 3,
  "name": "مرصاد - الرصد الآلي لـ Teams",
  "version": "0.6.26",
  "description": "الرصد باسم المنظّم من Teams بثلاث دورات وفاصل مستقل بين الأولى والثانية وبين الثانية والثالثة.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "downloads",
    "nativeMessaging",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://mirsad-school.onrender.com/*",
    "<all_urls>",
    "https://schools.madrasati.sa/*"
  ],
  "action": {
    "default_title": "مرصاد — الرصد متوقف",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "schedule-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mirsad-school.onrender.com/*"
      ],
      "js": [
        "schedule-core.js",
        "schedule.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mirsad-school.onrender.com/automatic-attendance.html"
      ],
      "js": [
        "report-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mirsad-school.onrender.com/automatic-monitoring.html"
      ],
      "js": [
        "monitor-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://schools.madrasati.sa/*"
      ],
      "js": [
        "madrasati-reader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/off-16.png",
    "32": "icons/off-32.png",
    "48": "icons/off-48.png",
    "128": "icons/off-128.png"
  }
}
