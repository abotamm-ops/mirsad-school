{
  "manifest_version": 3,
  "name": "مرصاد - الرصد الآلي لـ Teams",
  "version": "0.3.7",
  "description": "تشغيل الرصد التجريبي مع إغلاق كل تبويب فحص بعد النتيجة أو المهلة أو الإيقاف.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://mirsad-school.onrender.com/*"
  ],
  "action": {
    "default_title": "مرصاد - تشغيل الرصد",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mirsad-school.onrender.com/*"
      ],
      "js": [
        "schedule.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
