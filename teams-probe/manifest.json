{
  "manifest_version": 3,
  "name": "مرصاد - الرصد الآلي لـ Teams",
  "version": "0.6.3",
  "description": "الرصد باسم المنظّم من Teams مع إعداد عدد الدورات 1–3 والفاصل بينها 1–10 دقائق.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "downloads",
    "nativeMessaging",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://mirsad-school.onrender.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "مرصاد - تشغيل الرصد",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "schedule-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mirsad-school.onrender.com/*"
      ],
      "js": [
        "schedule-core.js",
        "schedule.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mirsad-school.onrender.com/automatic-attendance.html"
      ],
      "js": [
        "report-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mirsad-school.onrender.com/automatic-monitoring.html"
      ],
      "js": [
        "monitor-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
